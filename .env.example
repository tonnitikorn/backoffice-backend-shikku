NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>
MONGODB_DB=shikkulens

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000

# LINE Messaging API (optional - notifications fall back to in-system only when unset)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Object storage (optional - falls back to local disk /uploads when unset)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Read stock from tray photos with Claude vision (optional - when unset, staff copy a prompt into the Claude app and paste the reply back)
ANTHROPIC_API_KEY=
# STOCK_SCAN_MODEL=claude-opus-5
